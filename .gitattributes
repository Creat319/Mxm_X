# Normalize line endings across platforms
* text=auto

*.java       text eol=lf
*.mcfunction text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.xml        text eol=lf
*.sh         text eol=lf
*.bat        text eol=crlf
*.nbt        binary
*.zip        binary
